generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName           String?
  username           String?           @unique
  email              String?           @unique
  passwordHash       String?
  bio                String?
  walletAddress      String            @unique
  isVerified         Boolean           @default(false)
  createdAt          DateTime          @default(now())
  nonce              String?
  nonceExpiresAt     DateTime?
  avatarUrl          String?           @map("profileImage")
  profileMetadata    Json?
  reputationScore    Float             @default(0)
  updatedAt          DateTime          @updatedAt
  role               UserRole          @default(FREELANCER)
  githubUrl          String?
  linkedinUrl        String?
  portfolioUrl       String?
  skills             String[]          @default([])
  messages           Message[]
  messageReactions   MessageReaction[]
  messageReads       MessageRead[]
  notifications      Notification[]
  paymentsAsPayee    Payment[]         @relation("PaymentPayee")
  paymentsAsPayer    Payment[]         @relation("PaymentPayer")
  adminAuditLogs      AdminAuditLog[]   @relation("AdminAuditActor")
  adminSuspensions    UserSuspension[]  @relation("SuspensionAdmin")
  assignedDisputes    Dispute[]         @relation("DisputeAssignedAdmin")
  assignedFraudAlerts FraudAlert[]      @relation("FraudAlertAssignee")
  disputeResolutions  DisputeResolution[] @relation("DisputeResolutionAdmin")
  disputesAgainst     Dispute[]         @relation("DisputeAgainstUser")
  disputesRaised      Dispute[]         @relation("DisputeRaisedBy")
  fraudAlerts         FraudAlert[]      @relation("FraudAlertUser")
  nftCertificates    NftCertificate[]
  freelancerProjects Project[]         @relation("FreelancerProjects")
  invitedProjects    Project[]         @relation("InvitedProjects")
  projects           Project[]         @relation("OwnerProjects")
  sessions           Session[]
  userSuspensions     UserSuspension[]  @relation("SuspendedUser")
  submissions        Submission[]
  linkedWallets      UserWallet[]

  @@index([walletAddress])
  @@index([role])
  @@index([createdAt])
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @db.Uuid
  refreshToken String   @unique
  deviceInfo   String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
}

model UserWallet {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @db.Uuid
  walletAddress String   @unique
  isPrimary     Boolean  @default(false)
  linkedAt      DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([walletAddress])
}

model Project {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title               String
  description         String?
  status              String        @default("open")
  budget              Float?
  createdAt           DateTime      @default(now())
  ownerId             String        @db.Uuid
  updatedAt           DateTime      @updatedAt
  deadline            DateTime?
  freelancerId        String?       @db.Uuid
  invitedFreelancerId String?       @db.Uuid
  conversation        Conversation?
  disputes            Dispute[]
  milestones          Milestone[]
  payments            Payment[]
  nftCertificates     NftCertificate[]
  freelancer          User?         @relation("FreelancerProjects", fields: [freelancerId], references: [id])
  invitedFreelancer   User?         @relation("InvitedProjects", fields: [invitedFreelancerId], references: [id])
  owner               User          @relation("OwnerProjects", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([freelancerId])
  @@index([invitedFreelancerId])
  @@index([status])
}

model Milestone {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  amount      Float
  status      String       @default("pending")
  projectId   String       @db.Uuid
  createdAt   DateTime     @default(now())
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payments    Payment[]
  disputes    Dispute[]
  submissions Submission[]

  @@index([projectId])
  @@index([status])
}

model Submission {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  githubLink    String?
  demoLink      String?
  remarks       String?
  createdAt     DateTime  @default(now())
  milestoneId   String    @db.Uuid
  submittedById String    @db.Uuid
  updatedAt     DateTime  @updatedAt
  ipfsCid       String?
  fileName      String?
  fileSize      Int?
  mimeType      String?
  version       Int       @default(1)
  payments      Payment[]
  milestone     Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  submittedBy   User      @relation(fields: [submittedById], references: [id], onDelete: Cascade)

  @@index([milestoneId])
  @@index([submittedById])
  @@index([ipfsCid])
  @@index([milestoneId, version])
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      String   @default("system")
  title     String
  message   String
  actionUrl String?
  metadata  Json     @default("{}")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type, createdAt])
}

model Payment {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId     String        @db.Uuid
  milestoneId   String?       @db.Uuid
  submissionId  String?       @db.Uuid
  payerId       String        @db.Uuid
  payeeId       String        @db.Uuid
  type          PaymentType
  status        PaymentStatus @default(pending)
  amount        Float
  currency      String        @default("mUSD")
  escrowAddress String?
  releasedAt    DateTime?
  failureReason String?
  metadata      Json          @default("{}")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  milestone     Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  payee         User          @relation("PaymentPayee", fields: [payeeId], references: [id])
  payer         User          @relation("PaymentPayer", fields: [payerId], references: [id])
  project       Project       @relation(fields: [projectId], references: [id])
  submission    Submission?   @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  nftCertificate NftCertificate?
  transactions  Transaction[]
  disputeResolutions DisputeResolution[]
  transactionMonitorings TransactionMonitoring[]

  @@index([projectId, status, createdAt])
  @@index([payeeId, status, createdAt])
  @@index([payerId, status, createdAt])
  @@index([milestoneId, type])
}

model Transaction {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId        String?           @db.Uuid
  milestoneId      String?           @db.Uuid
  paymentId        String?           @db.Uuid
  nftCertificateId String?           @db.Uuid
  initiatedBy      String?           @db.Uuid
  type             TransactionType
  status           TransactionStatus @default(queued)
  chainId          Int
  txHash           String?
  relayerRequestId String?
  fromAddress      String?
  toAddress        String?
  amount           Float?
  currency         String?
  gasUsed          Float?
  gasQuote         Float?
  gasQuoteCurrency String?
  blockNumber      Int?
  errorMessage     String?
  submittedAt      DateTime?
  confirmedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  payment          Payment?          @relation(fields: [paymentId], references: [id])
  nftCertificate   NftCertificate?   @relation(fields: [nftCertificateId], references: [id], onDelete: SetNull)
  monitoring        TransactionMonitoring?

  @@index([paymentId, createdAt])
  @@index([status, createdAt])
}

model BlockchainIndexedEvent {
  id               String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chainId          Int
  contractAddress  String
  category         BlockchainEventCategory
  eventName        String
  txHash           String
  logIndex         Int
  blockNumber      Int
  blockHash        String?
  transactionIndex Int?
  removed          Boolean                         @default(false)
  args             Json                            @default("{}")
  rawLog           Json                            @default("{}")
  processingStatus BlockchainEventProcessingStatus @default(processed)
  processingError  String?
  paymentId        String?                         @db.Uuid
  transactionId    String?                         @db.Uuid
  nftCertificateId String?                         @db.Uuid
  indexedAt        DateTime                        @default(now())
  processedAt      DateTime?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt

  @@unique([chainId, txHash, logIndex])
  @@index([category, eventName, blockNumber])
  @@index([contractAddress, blockNumber])
  @@index([paymentId])
  @@index([transactionId])
  @@index([nftCertificateId])
}

model BlockchainIndexerCursor {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chainId         Int
  source          String
  contractAddress String
  lastBlockNumber Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([chainId, source, contractAddress])
  @@index([source])
}

model NftCertificate {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String               @db.Uuid
  projectId         String               @db.Uuid
  paymentId         String?              @unique @db.Uuid
  freelancerWallet  String
  tokenId           Int                  @unique
  metadataURI       String
  metadata          Json
  transactionHash   String?              @unique
  blockNumber       Int?
  gasUsed           Float?
  certificateStatus NftCertificateStatus @default(pending)
  mintedAt          DateTime?
  verifiedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payment           Payment?             @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  transactions      Transaction[]
  transactionMonitorings TransactionMonitoring[]

  @@unique([projectId])
  @@index([userId])
  @@index([projectId])
  @@index([freelancerWallet])
  @@index([certificateStatus, createdAt])
  @@index([transactionHash])
}

model Conversation {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String    @unique @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([projectId])
  @@index([updatedAt])
}

model Message {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId      String            @db.Uuid
  senderId            String            @db.Uuid
  content             String
  messageType         MessageType       @default(TEXT)
  attachmentUrl       String?
  attachmentType      String?
  isEdited            Boolean           @default(false)
  isDeleted           Boolean           @default(false)
  deliveredAt         DateTime          @default(now())
  messageHash         String?
  blockchainTxHash    String?
  blockchainProofedAt DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  attachments         Attachment[]
  conversation        Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender              User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions           MessageReaction[]
  reads               MessageRead[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@index([messageType])
  @@index([messageHash])
}

model MessageReaction {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model MessageRead {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId, readAt])
}

model Attachment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId   String   @db.Uuid
  fileName    String
  fileUrl     String
  previewUrl  String?
  downloadUrl String?
  fileType    String
  fileSize    Int
  ipfsCid     String?
  createdAt   DateTime @default(now())
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([ipfsCid])
  @@index([fileType])
}

model AdminAuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId       String?  @db.Uuid
  actionType    String
  entityType    String
  entityId      String?
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  admin         User?    @relation("AdminAuditActor", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@index([entityType, entityId])
  @@index([actionType, createdAt])
  @@index([createdAt])
}

model FraudAlert {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String?            @db.Uuid
  assignedAdminId String?            @db.Uuid
  type            String
  severity        FraudAlertSeverity @default(MEDIUM)
  status          FraudAlertStatus   @default(OPEN)
  riskScore       Int                @default(0)
  title           String
  description     String?
  entityType      String
  entityId        String?
  walletAddress   String?
  txHash          String?
  signals         Json               @default("{}")
  detectedAt      DateTime           @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User?              @relation("FraudAlertUser", fields: [userId], references: [id], onDelete: SetNull)
  assignedAdmin   User?              @relation("FraudAlertAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  @@index([status, severity, createdAt])
  @@index([riskScore, createdAt])
  @@index([userId, createdAt])
  @@index([walletAddress])
  @@index([txHash])
  @@index([entityType, entityId])
}

model UserSuspension {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String           @db.Uuid
  adminId     String?          @db.Uuid
  status      SuspensionStatus @default(ACTIVE)
  reason      String
  startsAt    DateTime         @default(now())
  endsAt      DateTime?
  revokedAt   DateTime?
  metadata    Json             @default("{}")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation("SuspendedUser", fields: [userId], references: [id], onDelete: Cascade)
  admin       User?            @relation("SuspensionAdmin", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([adminId, createdAt])
  @@index([status, endsAt])
}

model Dispute {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId       String          @db.Uuid
  milestoneId     String?         @db.Uuid
  raisedById      String          @db.Uuid
  againstUserId   String?         @db.Uuid
  assignedAdminId String?         @db.Uuid
  status          DisputeStatus   @default(OPEN)
  priority        String          @default("medium")
  reason          String
  description     String?
  evidence        Json            @default("{}")
  walletActivity  Json            @default("{}")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  resolvedAt      DateTime?
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone       Milestone?      @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  raisedBy        User            @relation("DisputeRaisedBy", fields: [raisedById], references: [id], onDelete: Cascade)
  againstUser     User?           @relation("DisputeAgainstUser", fields: [againstUserId], references: [id], onDelete: SetNull)
  assignedAdmin   User?           @relation("DisputeAssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  resolutions     DisputeResolution[]

  @@index([projectId, status])
  @@index([milestoneId])
  @@index([raisedById, createdAt])
  @@index([againstUserId, createdAt])
  @@index([assignedAdminId, status])
  @@index([status, createdAt])
}

model DisputeResolution {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  disputeId        String                @db.Uuid
  adminId          String?               @db.Uuid
  paymentId        String?               @db.Uuid
  action           DisputeResolutionType
  notes            String
  releaseAmount    Float?
  refundAmount     Float?
  freelancerAmount Float?
  clientAmount     Float?
  previousValue    Json?
  newValue         Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  dispute          Dispute               @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  admin            User?                 @relation("DisputeResolutionAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  payment          Payment?              @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([disputeId, createdAt])
  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([paymentId])
}

model TransactionMonitoring {
  id               String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId    String?                     @unique @db.Uuid
  paymentId        String?                     @db.Uuid
  nftCertificateId String?                     @db.Uuid
  txHash           String?
  chainId          Int                         @default(84532)
  category         TransactionMonitoringCategory
  status           TransactionMonitoringStatus @default(PENDING)
  gasQuote         Float?
  gasQuoteCurrency String?
  latencyMs        Int?
  retryAttempts    Int                         @default(0)
  explorerUrl      String?
  failureReason    String?
  riskScore        Int                         @default(0)
  metadata         Json                        @default("{}")
  lastSyncedAt     DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  transaction      Transaction?                @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  payment          Payment?                    @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  nftCertificate   NftCertificate?             @relation(fields: [nftCertificateId], references: [id], onDelete: SetNull)

  @@index([txHash])
  @@index([status, createdAt])
  @@index([category, status])
  @@index([paymentId, createdAt])
  @@index([nftCertificateId, createdAt])
  @@index([riskScore, createdAt])
}

enum UserRole {
  FREELANCER
  CLIENT
  ADMIN
  SUPER_ADMIN
  MODERATOR
  SUPPORT_ADMIN
  BLOCKCHAIN_ADMIN
}

enum MessageType {
  TEXT
  FILE
  SYSTEM
}

enum PaymentStatus {
  pending
  escrowed
  released
  refunded
  failed
  cancelled
}

enum PaymentType {
  escrow_deposit
  milestone_release
  refund
  platform_fee
}

enum TransactionStatus {
  queued
  submitted
  confirmed
  failed
  replaced
}

enum TransactionType {
  escrow_deposit
  payment_release
  refund
  certificate_mint
  certificate_revoke
}

enum BlockchainEventCategory {
  ESCROW
  PAYMENT
  NFT_MINT
  UGF_EXECUTION
}

enum BlockchainEventProcessingStatus {
  processed
  failed
  skipped
}

enum NftCertificateStatus {
  pending
  minting
  minted
  verified
  failed
  revoked
}

enum FraudAlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudAlertStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum SuspensionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  ESCALATED
  RESOLVED
  REJECTED
}

enum DisputeResolutionType {
  RELEASE_PAYMENT
  REFUND_CLIENT
  SPLIT_PAYMENT
  REQUEST_EVIDENCE
  REJECT_DISPUTE
}

enum TransactionMonitoringCategory {
  UGF_PAYMENT
  ESCROW_RELEASE
  NFT_MINT
  GASLESS_EXECUTION
  INDEXER_EVENT
}

enum TransactionMonitoringStatus {
  PENDING
  PROCESSING
  CONFIRMED
  FAILED
  REVERTED
}
