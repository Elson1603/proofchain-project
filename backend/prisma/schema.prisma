generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName        String?
  username        String?        @unique
  email           String?        @unique
  passwordHash    String?
  bio             String?
  walletAddress   String         @unique
  isVerified      Boolean        @default(false)
  createdAt       DateTime       @default(now())
  nonce           String?
  nonceExpiresAt  DateTime?
  profileImage    String?
  profileMetadata Json?
  reputationScore Float          @default(0)
  updatedAt       DateTime       @updatedAt
  role            UserRole       @default(FREELANCER)
  notifications   Notification[]
  linkedWallets   UserWallet[]
  projects        Project[]     @relation("OwnerProjects")
  invitedProjects Project[]     @relation("InvitedProjects")
  freelancerProjects Project[]   @relation("FreelancerProjects")
  sessions        Session[]
  submissions     Submission[]
  paymentsAsPayer Payment[] @relation("PaymentPayer")
  paymentsAsPayee Payment[] @relation("PaymentPayee")

  @@index([walletAddress])
  @@index([role])
  @@index([createdAt])
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @db.Uuid
  refreshToken String   @unique
  deviceInfo   String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
}

model UserWallet {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @db.Uuid
  walletAddress String   @unique
  isPrimary     Boolean  @default(false)
  linkedAt      DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([walletAddress])
}

model Project {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  status      String      @default("open")
  budget      Float?
  deadline    DateTime?
  createdAt   DateTime    @default(now())
  ownerId     String      @db.Uuid
  freelancerId String?    @db.Uuid
  invitedFreelancerId String? @db.Uuid
  updatedAt   DateTime    @updatedAt
  milestones  Milestone[]
  payments    Payment[]
  owner       User        @relation("OwnerProjects", fields: [ownerId], references: [id], onDelete: Cascade)
  freelancer  User?       @relation("FreelancerProjects", fields: [freelancerId], references: [id], onDelete: SetNull)
  invitedFreelancer User? @relation("InvitedProjects", fields: [invitedFreelancerId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([freelancerId])
  @@index([invitedFreelancerId])
  @@index([status])
}

model Milestone {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  amount      Float
  status      String       @default("pending")
  projectId   String       @db.Uuid
  createdAt   DateTime     @default(now())
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submissions Submission[]
  payments    Payment[]

  @@index([projectId])
  @@index([status])
}

model Submission {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  githubLink    String?
  demoLink      String?
  remarks       String?
  createdAt     DateTime  @default(now())
  milestoneId   String    @db.Uuid
  submittedById String    @db.Uuid
  milestone     Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  submittedBy   User      @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  payments      Payment[]

  @@index([milestoneId])
  @@index([submittedById])
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

enum UserRole {
  FREELANCER
  CLIENT
  ADMIN
}

enum PaymentStatus {
  pending
  escrowed
  released
  refunded
  failed
  cancelled
}

enum PaymentType {
  escrow_deposit
  milestone_release
  refund
  platform_fee
}

enum TransactionStatus {
  queued
  submitted
  confirmed
  failed
  replaced
}

enum TransactionType {
  escrow_deposit
  payment_release
  refund
  certificate_mint
  certificate_revoke
}

model Payment {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId     String        @db.Uuid
  milestoneId   String?       @db.Uuid
  submissionId  String?       @db.Uuid
  payerId       String        @db.Uuid
  payeeId       String        @db.Uuid
  type          PaymentType
  status        PaymentStatus @default(pending)
  amount        Float
  currency      String        @default("mUSD")
  escrowAddress String?
  releasedAt    DateTime?
  failureReason String?
  metadata      Json          @default("{}")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  milestone  Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  payer      User       @relation("PaymentPayer", fields: [payerId], references: [id], onDelete: Restrict)
  payee      User       @relation("PaymentPayee", fields: [payeeId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([projectId, status, createdAt])
  @@index([payeeId, status, createdAt])
  @@index([payerId, status, createdAt])
  @@index([milestoneId, type])
}

model Transaction {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId        String?           @db.Uuid
  milestoneId      String?           @db.Uuid
  paymentId        String?           @db.Uuid
  nftCertificateId String?           @db.Uuid
  initiatedBy      String?           @db.Uuid
  type             TransactionType
  status           TransactionStatus @default(queued)
  chainId          Int
  txHash           String?
  relayerRequestId String?
  fromAddress      String?
  toAddress        String?
  amount           Float?
  currency         String?
  gasUsed          Float?
  gasQuote         Float?
  gasQuoteCurrency String?
  blockNumber      Int?
  errorMessage     String?
  submittedAt      DateTime?
  confirmedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([paymentId, createdAt])
  @@index([status, createdAt])
}
