generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName        String?
  username        String?        @unique
  email           String?        @unique
  passwordHash    String?
  bio             String?
  walletAddress   String         @unique
  isVerified      Boolean        @default(false)
  createdAt       DateTime       @default(now())
  nonce           String?
  nonceExpiresAt  DateTime?
  profileImage    String?
  profileMetadata Json?
  reputationScore Float          @default(0)
  updatedAt       DateTime       @updatedAt
  role            UserRole       @default(FREELANCER)
  notifications   Notification[]
  linkedWallets   UserWallet[]
  projects        Project[]
  sessions        Session[]
  submissions     Submission[]

  @@index([walletAddress])
  @@index([role])
  @@index([createdAt])
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @db.Uuid
  refreshToken String   @unique
  deviceInfo   String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
}

model UserWallet {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @db.Uuid
  walletAddress String   @unique
  isPrimary     Boolean  @default(false)
  linkedAt      DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([walletAddress])
}

model Project {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  status      String      @default("open")
  budget      Float?
  createdAt   DateTime    @default(now())
  ownerId     String      @db.Uuid
  updatedAt   DateTime    @updatedAt
  milestones  Milestone[]
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([status])
}

model Milestone {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  amount      Float
  status      String       @default("pending")
  projectId   String       @db.Uuid
  createdAt   DateTime     @default(now())
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([projectId])
  @@index([status])
}

model Submission {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  githubLink    String?
  demoLink      String?
  remarks       String?
  createdAt     DateTime  @default(now())
  milestoneId   String    @db.Uuid
  submittedById String    @db.Uuid
  milestone     Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  submittedBy   User      @relation(fields: [submittedById], references: [id], onDelete: Cascade)

  @@index([milestoneId])
  @@index([submittedById])
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

enum UserRole {
  FREELANCER
  CLIENT
  ADMIN
}
