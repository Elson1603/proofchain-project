generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName           String?
  username           String?           @unique
  email              String?           @unique
  passwordHash       String?
  bio                String?
  walletAddress      String            @unique
  isVerified         Boolean           @default(false)
  createdAt          DateTime          @default(now())
  nonce              String?
  nonceExpiresAt     DateTime?
  avatarUrl          String?           @map("profileImage")
  profileMetadata    Json?
  reputationScore    Float             @default(0)
  updatedAt          DateTime          @updatedAt
  role               UserRole          @default(FREELANCER)
  githubUrl          String?
  linkedinUrl        String?
  portfolioUrl       String?
  skills             String[]          @default([])
  messages           Message[]
  messageReactions   MessageReaction[]
  messageReads       MessageRead[]
  notifications      Notification[]
  paymentsAsPayee    Payment[]         @relation("PaymentPayee")
  paymentsAsPayer    Payment[]         @relation("PaymentPayer")
  nftCertificates    NftCertificate[]
  freelancerProjects Project[]         @relation("FreelancerProjects")
  invitedProjects    Project[]         @relation("InvitedProjects")
  projects           Project[]         @relation("OwnerProjects")
  sessions           Session[]
  submissions        Submission[]
  linkedWallets      UserWallet[]

  @@index([walletAddress])
  @@index([role])
  @@index([createdAt])
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @db.Uuid
  refreshToken String   @unique
  deviceInfo   String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
}

model UserWallet {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @db.Uuid
  walletAddress String   @unique
  isPrimary     Boolean  @default(false)
  linkedAt      DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([walletAddress])
}

model Project {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title               String
  description         String?
  status              String        @default("open")
  budget              Float?
  createdAt           DateTime      @default(now())
  ownerId             String        @db.Uuid
  updatedAt           DateTime      @updatedAt
  deadline            DateTime?
  freelancerId        String?       @db.Uuid
  invitedFreelancerId String?       @db.Uuid
  conversation        Conversation?
  milestones          Milestone[]
  payments            Payment[]
  nftCertificates     NftCertificate[]
  freelancer          User?         @relation("FreelancerProjects", fields: [freelancerId], references: [id])
  invitedFreelancer   User?         @relation("InvitedProjects", fields: [invitedFreelancerId], references: [id])
  owner               User          @relation("OwnerProjects", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([freelancerId])
  @@index([invitedFreelancerId])
  @@index([status])
}

model Milestone {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  amount      Float
  status      String       @default("pending")
  projectId   String       @db.Uuid
  createdAt   DateTime     @default(now())
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payments    Payment[]
  submissions Submission[]

  @@index([projectId])
  @@index([status])
}

model Submission {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  githubLink    String?
  demoLink      String?
  remarks       String?
  createdAt     DateTime  @default(now())
  milestoneId   String    @db.Uuid
  submittedById String    @db.Uuid
  updatedAt     DateTime  @updatedAt
  ipfsCid       String?
  fileName      String?
  fileSize      Int?
  mimeType      String?
  version       Int       @default(1)
  payments      Payment[]
  milestone     Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  submittedBy   User      @relation(fields: [submittedById], references: [id], onDelete: Cascade)

  @@index([milestoneId])
  @@index([submittedById])
  @@index([ipfsCid])
  @@index([milestoneId, version])
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model Payment {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId     String        @db.Uuid
  milestoneId   String?       @db.Uuid
  submissionId  String?       @db.Uuid
  payerId       String        @db.Uuid
  payeeId       String        @db.Uuid
  type          PaymentType
  status        PaymentStatus @default(pending)
  amount        Float
  currency      String        @default("mUSD")
  escrowAddress String?
  releasedAt    DateTime?
  failureReason String?
  metadata      Json          @default("{}")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  milestone     Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  payee         User          @relation("PaymentPayee", fields: [payeeId], references: [id])
  payer         User          @relation("PaymentPayer", fields: [payerId], references: [id])
  project       Project       @relation(fields: [projectId], references: [id])
  submission    Submission?   @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  nftCertificate NftCertificate?
  transactions  Transaction[]

  @@index([projectId, status, createdAt])
  @@index([payeeId, status, createdAt])
  @@index([payerId, status, createdAt])
  @@index([milestoneId, type])
}

model Transaction {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId        String?           @db.Uuid
  milestoneId      String?           @db.Uuid
  paymentId        String?           @db.Uuid
  nftCertificateId String?           @db.Uuid
  initiatedBy      String?           @db.Uuid
  type             TransactionType
  status           TransactionStatus @default(queued)
  chainId          Int
  txHash           String?
  relayerRequestId String?
  fromAddress      String?
  toAddress        String?
  amount           Float?
  currency         String?
  gasUsed          Float?
  gasQuote         Float?
  gasQuoteCurrency String?
  blockNumber      Int?
  errorMessage     String?
  submittedAt      DateTime?
  confirmedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  payment          Payment?          @relation(fields: [paymentId], references: [id])
  nftCertificate   NftCertificate?   @relation(fields: [nftCertificateId], references: [id], onDelete: SetNull)

  @@index([paymentId, createdAt])
  @@index([status, createdAt])
}

model NftCertificate {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String               @db.Uuid
  projectId         String               @db.Uuid
  paymentId         String?              @unique @db.Uuid
  freelancerWallet  String
  tokenId           Int                  @unique
  metadataURI       String
  metadata          Json
  transactionHash   String?              @unique
  blockNumber       Int?
  gasUsed           Float?
  certificateStatus NftCertificateStatus @default(pending)
  mintedAt          DateTime?
  verifiedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payment           Payment?             @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  transactions      Transaction[]

  @@unique([projectId])
  @@index([userId])
  @@index([projectId])
  @@index([freelancerWallet])
  @@index([certificateStatus, createdAt])
  @@index([transactionHash])
}

model Conversation {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String    @unique @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([projectId])
  @@index([updatedAt])
}

model Message {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId      String            @db.Uuid
  senderId            String            @db.Uuid
  content             String
  messageType         MessageType       @default(TEXT)
  attachmentUrl       String?
  attachmentType      String?
  isEdited            Boolean           @default(false)
  isDeleted           Boolean           @default(false)
  deliveredAt         DateTime          @default(now())
  messageHash         String?
  blockchainTxHash    String?
  blockchainProofedAt DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  attachments         Attachment[]
  conversation        Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender              User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions           MessageReaction[]
  reads               MessageRead[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@index([messageType])
  @@index([messageHash])
}

model MessageReaction {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model MessageRead {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId, readAt])
}

model Attachment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId   String   @db.Uuid
  fileName    String
  fileUrl     String
  previewUrl  String?
  downloadUrl String?
  fileType    String
  fileSize    Int
  ipfsCid     String?
  createdAt   DateTime @default(now())
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([ipfsCid])
  @@index([fileType])
}

enum UserRole {
  FREELANCER
  CLIENT
  ADMIN
}

enum MessageType {
  TEXT
  FILE
  SYSTEM
}

enum PaymentStatus {
  pending
  escrowed
  released
  refunded
  failed
  cancelled
}

enum PaymentType {
  escrow_deposit
  milestone_release
  refund
  platform_fee
}

enum TransactionStatus {
  queued
  submitted
  confirmed
  failed
  replaced
}

enum TransactionType {
  escrow_deposit
  payment_release
  refund
  certificate_mint
  certificate_revoke
}

enum NftCertificateStatus {
  pending
  minting
  minted
  verified
  failed
  revoked
}
